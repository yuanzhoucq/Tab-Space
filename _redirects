# Cloudflare Pages strips the .html suffix by default and 308s /redirect.html
# to /redirect. Shipped Safari extensions cannot tolerate that: the injected
# content script compares location.pathname against the literal "/redirect.html"
# (Tab-Works Extension/tabspace.js), so the rewritten path silently disables the
# native hand-off for every installed build, which will never update.
#
# A 200 rewrite serves the same asset while leaving the address bar — and
# therefore location.pathname — on /redirect.html. Cloudflare does not document
# the precedence, but an explicit rule here was confirmed in production to win
# over the built-in suffix stripping. Re-check this after any Pages runtime
# change: if the rule stops winning, /redirect.html silently 308s again and the
# native hand-off breaks with no other symptom.
/redirect.html  /redirect  200

# Unlisted session ids are interpreted by the static, script-safe viewer.
# Target the canonical directory URL: Pages strips /index.html, and rejects a
# proxy target containing it as a potential rewrite loop. IDs are Base64URL and
# therefore always occupy exactly one path segment.
/s/:id  /share/  200

# storage.html deliberately has no rule. Its only consumer is the legacy iframe
# relay, which matches the host static.mytab.space, a different origin that is
# not served by this Pages project and does not strip the suffix.
