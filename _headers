/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin

# Marketing-site assets are not content-hashed, so nothing here may be
# marked immutable except the font, whose bytes never change.
# Everything else revalidates cheaply via ETag.

/*.html
  Cache-Control: no-cache, no-transform

/
  Cache-Control: no-cache, no-transform

/assets/css/*
  Cache-Control: no-cache, no-transform

/assets/img/*
  Cache-Control: public, max-age=86400, must-revalidate

/assets/*.woff2
  Cache-Control: public, max-age=31536000, immutable

/assets/*.mp4
  Cache-Control: public, max-age=604800, must-revalidate

/s/*
  Cache-Control: private, no-store, no-transform
  Content-Security-Policy: default-src 'none'; script-src 'self'; style-src 'self'; img-src 'self' https://t2.gstatic.com; connect-src https://tabspace-worker.mytab.space; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  Referrer-Policy: no-referrer
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  X-Robots-Tag: noindex, nofollow, noarchive
